{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "curvia-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv7",
          "numberOfShards": 1,
          "numberOfReplicas": 0,
          "typeName": null
        }
      }
    ],
    "Properties": {
      "Application": "Curvia.API",
      "Environment": "Development"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "HangfireConnection": "Server=localhost,1433;Database=Curvia_Hangfire;User ID=sa;Password=MyStrong@Pass123;TrustServerCertificate=True;",
    "CurviaDbContextConnectionString": "Server=localhost,1433;Database=Curvia;User ID=sa;Password=MyStrong@Pass123;TrustServerCertificate=True;"
  },
  "Routing": {
    "Valhalla": {
      "BaseUrl": "http://localhost:8002",
      "TimeoutSeconds": 60
    }
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "Curvia",
    "ClientId": "Curvia-API",
    "Audience": "Curvia-API",
    "Scopes": "openid profile email offline_access",
    "RequireHttpsMetadata": false,
    "ClientSecret": "oVcU3gnatfDesJLHPMkwePZjZsvreqco"
  },
  "TokenRevocation": {
    "RevokeAllTtl": "30.00:00:00"
  },
  "AwarenessSync": {
    "IncidentFeeds": [
      {
        "CountryCode": "BE",
        "Url": "https://www.verkeerscentrum.be/uitwisseling/datex2v3full",
        "Format": "DatexII_XML",
        "ApiKey": ""
      },
      {
        "CountryCode": "NL",
        "Url": "https://opendata.ndw.nu/incidents.xml.gz",
        "Format": "DatexII_XML_GZ",
        "ApiKey": ""
      }
    ]
  }
}