{
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "CurviaDbContextConnectionString": "Server=localhost;Database=Curvia;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Routing": {
    "Valhalla": {
      "BaseUrl": "http://localhost:8002",
      "TimeoutSeconds": 60
    }
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "Curvia",
    "ClientId": "Curvia-API",
    "Audience": "Curvia-API",
    "Scopes": "openid profile email offline_access",
    "RequireHttpsMetadata":false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
